# Web app configuration.
#
# EVERY value here is compiled into the browser bundle in clear text.
# Never put a provider key, token or password in this file or in a .env file.
# Secrets live in Cloudflare Worker secrets (`wrangler secret put`) and are
# only ever used server-side by apps/edge.
#
# Copy to .env.local for local overrides (.env* is gitignored).

# Which deployment this build targets: local | staging | production
VITE_ENVIRONMENT=local

# Base URL for published static artifacts (R2 custom domain in staging/production).
VITE_DATA_BASE_URL=/data

# Base URL for the edge API. Same-origin in production; the Worker dev server locally.
VITE_API_BASE_URL=http://127.0.0.1:8787

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letzscan.lu/schemas/dataset.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "indicator_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      }
    },
    "geography_set_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "cadence": {
      "type": "string",
      "enum": [
        "realtime",
        "sub_hourly",
        "hourly",
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "annual",
        "irregular",
        "static"
      ]
    },
    "temporal_coverage": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^(?:\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?)?|\\d{4}-Q[1-4]|\\d{4}-W(?:0[1-9]|[1-4]\\d|5[0-3])|\\d{4}-\\d{2}-\\d{2}T[0-2]\\d:[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|[+-][0-2]\\d:[0-5]\\d))(?:\\/(?:\\d{4}(?:-\\d{2}(?:-\\d{2})?)?|\\d{4}-Q[1-4]|\\d{4}-\\d{2}-\\d{2}T[0-2]\\d:[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|[+-][0-2]\\d:[0-5]\\d)))?$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?:\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?)?|\\d{4}-Q[1-4]|\\d{4}-W(?:0[1-9]|[1-4]\\d|5[0-3])|\\d{4}-\\d{2}-\\d{2}T[0-2]\\d:[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|[+-][0-2]\\d:[0-5]\\d))(?:\\/(?:\\d{4}(?:-\\d{2}(?:-\\d{2})?)?|\\d{4}-Q[1-4]|\\d{4}-\\d{2}-\\d{2}T[0-2]\\d:[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|[+-][0-2]\\d:[0-5]\\d)))?$"
        }
      }
    },
    "caveats": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_published_at": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "id",
    "source_id",
    "title",
    "indicator_ids",
    "cadence"
  ],
  "title": "Dataset",
  "description": "A normalised, citable LëtzScan dataset derived from one source."
}

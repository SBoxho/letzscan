{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letzscan.lu/schemas/basemap.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "tiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https:\\/\\/(?=\\S*\\{z\\})(?=\\S*\\{x\\})(?=\\S*\\{y\\})\\S+$"
      }
    },
    "tile_size": {
      "anyOf": [
        {
          "type": "number",
          "const": 256
        },
        {
          "type": "number",
          "const": 512
        }
      ]
    },
    "min_zoom": {
      "type": "integer",
      "minimum": 0,
      "maximum": 24
    },
    "max_zoom": {
      "type": "integer",
      "minimum": 0,
      "maximum": 24
    },
    "status": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "active",
        "disabled"
      ]
    },
    "status_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "source_id",
    "tiles",
    "tile_size",
    "min_zoom",
    "max_zoom"
  ],
  "title": "Basemap",
  "description": "A reviewed, credential-free raster basemap drawn beneath LëtzScan layers."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letzscan.lu/schemas/indicator.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "value_type": {
      "type": "string",
      "enum": [
        "count",
        "amount",
        "rate",
        "ratio",
        "index",
        "category"
      ]
    },
    "aggregation": {
      "type": "string",
      "enum": [
        "sum",
        "mean",
        "median",
        "none"
      ]
    },
    "denominator_indicator_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "decimals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "definition",
    "unit",
    "value_type",
    "aggregation"
  ],
  "title": "Indicator",
  "description": "A stable measure definition shared by every rendering of a value."
}
